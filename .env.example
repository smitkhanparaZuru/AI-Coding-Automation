# AICA Environment Configuration
# Copy this file to .env and fill in your values.

# Application
AICA_APP_NAME=AICA
AICA_DEBUG=false
AICA_LOG_LEVEL=INFO

# Workspace
AICA_WORKSPACE_DIR=.

# LLM
AICA_LLM_PROVIDER=ollama               # ollama | openrouter
AICA_OLLAMA_BASE_URL=http://localhost:11434
AICA_OLLAMA_MODEL=                     # Model name, e.g. llama3.2 or codellama
AICA_OPENROUTER_API_KEY=               # Required when LLM_PROVIDER=openrouter
AICA_OPENROUTER_MODEL=                 # Model name, e.g. openai/gpt-4o-mini
AICA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AICA_LLM_TIMEOUT=60                    # Request timeout in seconds
AICA_LLM_MAX_RETRIES=3                 # Max retry attempts on transient errors
AICA_LLM_RETRY_MIN_WAIT=1.0            # Minimum exponential back-off wait (seconds)
AICA_LLM_RETRY_MAX_WAIT=10.0           # Maximum exponential back-off wait (seconds)

# Databases
AICA_VECTOR_DB_URL=http://localhost:8000   # ChromaDB default (future use)
AICA_GRAPH_DB_URL=bolt://localhost:7687    # Neo4j default (legacy, use NEO4J_URI instead)

# Neo4j (Graph Database)
AICA_NEO4J_URI=bolt://localhost:7687       # Neo4j connection URI (bolt:// or neo4j+s://)
AICA_NEO4J_USER=neo4j                      # Neo4j username
AICA_NEO4J_PASSWORD=password               # Neo4j password (should match Docker NEO4J_AUTH)
AICA_NEO4J_DATABASE=neo4j                  # Neo4j target database name

# Qdrant (Vector Store)
AICA_QDRANT_URL=http://localhost:6333      # Qdrant server URL
AICA_QDRANT_API_KEY=                       # Qdrant API key (optional, leave empty for local Docker)
AICA_QDRANT_COLLECTION_NAME=aica-code      # Collection name for code embeddings
AICA_QDRANT_VECTOR_DIMENSION=              # Vector dimension (auto-detect from model if empty)
AICA_QDRANT_BATCH_SIZE=500                 # Batch size for vector upsert operations

# Embedding Provider
AICA_EMBEDDING_PROVIDER=ollama             # ollama | openrouter
AICA_EMBEDDING_MODEL=nomic-embed-text      # Model name (e.g. nomic-embed-text for Ollama, openai/text-embedding-3-small for OpenRouter)
AICA_EMBEDDING_BATCH_SIZE=32               # Batch size for embedding generation
AICA_EMBEDDING_TIMEOUT=60                  # Embedding request timeout in seconds
AICA_EMBEDDING_MAX_RETRIES=3               # Max retry attempts on transient errors
AICA_EMBEDDING_RETRY_MIN_WAIT=1.0          # Minimum exponential back-off wait (seconds)
AICA_EMBEDDING_RETRY_MAX_WAIT=10.0         # Maximum exponential back-off wait (seconds)
AICA_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434  # Ollama API base URL for embeddings
AICA_EMBEDDING_OPENROUTER_API_KEY=         # OpenRouter API key for embeddings (required when EMBEDDING_PROVIDER=openrouter)
AICA_EMBEDDING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter API base URL for embeddings

# Repository
AICA_REPO_PATH=.                       # Root of the repo to analyse

# Sync Behavior
AICA_SYNC_FALLBACK_THRESHOLD=0.20      # 0.0-1.0, percentage of changed files before full rescan
AICA_SYNC_MAX_AST_AGE_SECONDS=259200   # 3 days (259200s), max age before AST cache invalidation
AICA_SYNC_UPDATE_EMBEDDINGS=true       # Auto-update embeddings during repository sync (false to skip)
